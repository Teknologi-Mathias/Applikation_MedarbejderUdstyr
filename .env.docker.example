# Lokal Docker-database (docker-compose.yml). Kopiér til .env.docker og sæt
# en tilfældig adgangskode. .env.docker må ALDRIG committes.
#
# Kun superbrugerens adgangskode er en hemmelighed. PostgREST-kontoen
# (authenticator/lokaltest) og JWT-hemmeligheden er faste testværdier, der
# også står i tests/sql/supabase_stub.sql og tests/test_supabase_lokal.py.
POSTGRES_PASSWORD=<tilfældig adgangskode>
